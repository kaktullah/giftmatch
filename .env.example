# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Anthropic API key. Leave empty to run in DEMO MODE (no AI calls, rule-based results).
# Get one in the Claude Console (platform.claude.com) under API Keys. Keep it secret: never commit it.
ANTHROPIC_API_KEY=

# Model names are configurable. Cheap/fast model for concept generation,
# stronger model for reranking.
ANTHROPIC_MODEL_CONCEPTS=claude-haiku-5-5
ANTHROPIC_MODEL_RERANK=claude-sonnet-5-5

# Product sources, comma-separated. Several stores can be combined.
# "catalog" = built-in list of real products. Later e.g. "bolcom,awin,amazon".
PRODUCT_PROVIDERS=catalog

# Defaults for new questionnaires
DEFAULT_COUNTRY=NL
DEFAULT_CURRENCY=EUR

# Local SQLite database for anonymised logs
DATABASE_URL="file:./dev.db"
EUR_PER_USD=0.92
